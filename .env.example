# --- WebUntis (always) ---------------------------------------------------------
# Login name and the app secret from Profile → Data access ("Zugriff über Untis Mobile")
WEBUNTIS_USER=
WEBUNTIS_SECRET=

# --- TARGETS=nextcloud -----------------------------------------------------------
# Nextcloud user ID (not always the login name!) and an app password for it
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=

# --- TARGETS=caldav --------------------------------------------------------------
CALDAV_USER=
CALDAV_PASSWORD=

# --- TARGETS=google --------------------------------------------------------------
# OAuth client of type "Desktop app" from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
